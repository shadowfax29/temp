# Copy to .env and fill in. Never commit .env.
PORT=8090
NODE_ENV=development

# Its own database (not Taskly's)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ticketdesk
DB_PASSWORD=
DB_NAME=ticketdesk

# At least 32 characters
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Where the web app runs (CORS)
FRONTEND_URL=http://localhost:3040

# Optional: where uploaded files are kept (default: backend/uploads/tickets)
# TICKET_UPLOAD_DIR=

# Used only by `npm run db:seed` to create the first admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
