{
  "name": "ticketing-tool-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone ticketing tool: its own users, roles, teams, ticket types, tickets and timer",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/config/migrate.ts",
    "db:seed": "tsx src/scripts/seedAdmin.ts",
    "check": "tsx src/scripts/ticketingCheck.ts",
    "db:import-uvdesk": "tsx src/scripts/importUvdesk.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "html-to-text": "^10.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "nodemailer": "^6.10.1",
    "pino": "^9.2.0",
    "pino-pretty": "^13.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^6.4.24",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5"
  }
}
